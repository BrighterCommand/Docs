<Project Sdk="Microsoft.NET.Sdk">
  <!-- Task 4.5a (D19): #4437, the InMemory scheduler cancelling or rescheduling a request scheduled
       through the command processor. dotnet run -p:BV=10.7.0 (the control) and the default 10.8.0,
       once per case, its argument one of plain, cancel, reschedule, direct-cancel -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><Nullable>enable</Nullable><BV Condition="'$(BV)'==''">10.8.0</BV></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Paramore.Brighter" Version="$(BV)" />
    <PackageReference Include="Paramore.Brighter.Extensions.DependencyInjection" Version="$(BV)" />
  </ItemGroup>
</Project>

