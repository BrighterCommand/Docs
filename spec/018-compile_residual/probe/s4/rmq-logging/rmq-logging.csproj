<Project Sdk="Microsoft.NET.Sdk">
  <!-- Task 6.5, the Serilog ruling: RabbitMQConnectionStability.md #3, "Blocked events will be logged automatically",
       run against the released 10.8.1 packages and a real broker. The broker is a container started on localhost:5679
       for the run and removed after it:
         docker run -d - -name probe-rmq-logging -p 5679:5672 rabbitmq:3.13-management
         dotnet run - - case ; dotnet run - - control
         docker rm -f probe-rmq-logging
       Each arm is its own process, because what is under test is a static field's first initialisation. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Paramore.Brighter.MessagingGateway.RMQ.Async" Version="10.8.1" />
    <PackageReference Include="Paramore.Brighter.Extensions.DependencyInjection" Version="10.8.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>
</Project>
