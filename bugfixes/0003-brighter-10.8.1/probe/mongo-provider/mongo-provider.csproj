<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet run -p:BrighterVersion=10.8.1 (the case) and -p:BrighterVersion=10.8.0 (the control) -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <BrighterVersion Condition="'$(BrighterVersion)' == ''">10.8.1</BrighterVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Paramore.Brighter.Extensions.DependencyInjection" Version="$(BrighterVersion)" />
    <PackageReference Include="Paramore.Brighter.MongoDb" Version="$(BrighterVersion)" />
    <PackageReference Include="Paramore.Brighter.Outbox.MongoDb" Version="$(BrighterVersion)" />
  </ItemGroup>
</Project>
