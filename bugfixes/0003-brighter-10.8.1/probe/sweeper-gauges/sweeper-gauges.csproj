<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet run -p:BrighterVersion=10.8.1 (the case) and -p:BrighterVersion=10.8.0 (the control: no sweeper instruments) -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <BrighterVersion Condition="'$(BrighterVersion)' == ''">10.8.1</BrighterVersion>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Paramore.Brighter.Extensions.DependencyInjection" Version="$(BrighterVersion)" />
    <PackageReference Include="Paramore.Brighter.Outbox.Hosting" Version="$(BrighterVersion)" />
    <PackageReference Include="Paramore.Brighter.Extensions.Diagnostics" Version="$(BrighterVersion)" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.0" />
  </ItemGroup>
</Project>
