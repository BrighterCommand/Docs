{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 tools/linkcheck.py *)",
      "Bash(python3 tools/urlmap.py *)",
      "Bash(python3 tools/versioncheck.py *)",
      "Bash(python3 tools/symbolcheck.py *)",
      "Bash(dotnet run --project tools/optioncheck*)",

      "Bash(python3 tools/pagelint.py)",
      "Bash(python3 tools/pagelint.py --changed origin/master)",
      "Bash(python3 tools/pagelint.py contents/*)",
      "Bash(python3 tools/pagelint.py README.md)",

      "Bash(dotnet build tools/blockcheck/refs/refs.csproj *)",
      "Bash(dotnet build tools/blockcheck/blockcheck.csproj *)",
      "Bash(python3 tools/blockcheck.py *)"
    ],
    "deny": [
      "Bash(python3 tools/pagelint.py --fix*)",
      "Bash(python3 tools/pagelint.py --changed * --fix*)"
    ],
    "ask": []
  }
}
